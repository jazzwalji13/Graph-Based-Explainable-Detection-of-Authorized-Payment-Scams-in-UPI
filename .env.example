# SCAM-REPORT environment configuration. Copy to .env and adjust.
# The app works fully OFFLINE with these defaults.

# --- backend ---
SCAM_REPORT_DB=                 # default: backend/data/scam_report.db
SIM_CONFIG=                     # optional path to a JSON with simulator overrides

# --- optional LLM (OFF by default; app uses deterministic template phrasing) ---
# The LLM is used ONLY to phrase the narrative from extracted facts. It never invents facts.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# --- frontend ---
VITE_API_BASE=http://localhost:8011
